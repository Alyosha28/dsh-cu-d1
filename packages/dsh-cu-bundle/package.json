{
  "name": "@dsh-cu/bundle",
  "version": "0.2.7",
  "description": "DSH profile bundle that mounts the D1 Browser Use and Computer Use providers with their required registries",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-browser-use": "0.2.1-rc.5",
    "@deepseek-ai/dsh-computer-use": "0.2.1-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-computer-use": {
      "optional": true
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "devDependencies": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alyosha28/dsh-cu-d1.git",
    "directory": "packages/dsh-cu-bundle"
  },
  "homepage": "https://github.com/Alyosha28/dsh-cu-d1#readme",
  "bugs": {
    "url": "https://github.com/Alyosha28/dsh-cu-d1/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "browser-use",
    "computer-use",
    "macos",
    "agent"
  ]
}
